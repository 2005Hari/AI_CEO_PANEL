# LLM
GEMINI_API_KEY=
NVIDIA_API_KEY=
# meta/llama-3.1-* models reached end-of-life on NVIDIA's hosted API (2026-08-26).
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Database
USE_SQLITE=false
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aios
POSTGRES_PASSWORD=aios_dev_password
POSTGRES_DB=ai_startup_os

# Clerk
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=
AUTH_REQUIRED=true
DEV_MOCK_USER_ENABLED=false

# Local dev without Clerk (tests only)
# AUTH_REQUIRED=false
# DEV_MOCK_USER_ENABLED=true
# USE_SQLITE=true
