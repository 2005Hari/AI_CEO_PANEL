# LLM
GEMINI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Database
USE_SQLITE=false
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aios
POSTGRES_PASSWORD=aios_dev_password
POSTGRES_DB=ai_startup_os

# Clerk
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=
AUTH_REQUIRED=true
DEV_MOCK_USER_ENABLED=false

