# Clerk (get real values from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Without these, auth.protect() in src/proxy.ts falls back to Clerk's generic
# hosted Account Portal instead of the app's own dark-themed /sign-in and
# /sign-up pages — confirmed against real live traffic.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Backend API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
